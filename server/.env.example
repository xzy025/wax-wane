# LLM API Configuration
# Supports any OpenAI-compatible API (DeepSeek, Qwen, Moonshot, OpenAI, etc.)

LLM_API_URL=https://api.deepseek.com/v1/chat/completions
LLM_API_KEY=sk-your-api-key-here
LLM_MODEL=deepseek-chat

# 09:28 auction brief and 09:35 confirmation push.
# Register at https://sct.ftqq.com/ and keep the SendKey out of source control.
AUCTION_PUSH_ENABLED=false
SERVERCHAN_SEND_KEY=SCT-your-send-key-here
# Optional. Rules remain authoritative; AI only rewrites the short summary.
AUCTION_BRIEF_AI_ENABLED=true
AUCTION_BRIEF_AI_TIMEOUT_MS=4000

# RAG / embeddings
# Model used by the embeddings endpoint (rag/embedding.ts). Falls back to a
# deterministic char-ngram embedder when no embeddings API is available.
EMBEDDING_MODEL=text-embedding-3-small

# Observability (rag/agent tracing — see observability/tracer.ts)
# Max traces kept in the in-memory ring buffer.
OBS_MAX_TRACES=100
# Optional: append completed traces as JSONL to this dir (off by default).
# OBS_TRACE_DIR=./.traces

# Hithink Financial API research provider (never commit the API key).
# Connection/runtime controls are independent of research probe samples.
# HITHINK_FINANCE_BASE_URL=https://fuyao.aicubes.cn
# HITHINK_FINANCE_API_KEY=
# HITHINK_FINANCE_TIMEOUT_MS=12000
# HITHINK_FINANCE_REQUEST_GAP_MS=350
# HITHINK_FINANCE_MAX_RETRIES=3
# HITHINK_FINANCE_MAX_CONCURRENT=1
# HITHINK_FINANCE_MAX_QUEUE=100
# HITHINK_FINANCE_CACHE_TTL_MS=60000
# HITHINK_FINANCE_CACHE_MAX_ENTRIES=100
# HITHINK_FINANCE_CODES=000001.SZ,600519.SH
# HITHINK_FINANCE_INDEX_CODE=886042.TI
# HITHINK_FINANCE_START_DATE=2025-01-01
# HITHINK_FINANCE_END_DATE=2026-09-07
# HITHINK_FINANCE_TRADE_DATE=2026-09-07

# iFinD shadow capability probe (never commit tokens).
# Free iFinD interface accounts can be used for L1, snapshots and high-frequency
# checks. Generate custom Level-2/fund-flow indicators with the official Super
# Command; do not guess indicator IDs.
# IFIND_BASE_URL=https://quantapi.51ifind.com/api/v1
# IFIND_ACCESS_TOKEN=
# IFIND_REFRESH_TOKEN=
# IFIND_CODES=000001.SZ,600519.SH
# IFIND_TRADE_DATE=2026-08-24
# IFIND_START_TIME=09:30:00
# IFIND_END_TIME=15:00:00
# IFIND_L2_INDICATORS=
# IFIND_PROBE_REQUEST_FILE=./docs/research/ifind-probe-requests.json
# IFIND_RESEARCH_ROOT=./docs/research
# IFIND_TIMEOUT_MS=12000
# IFIND_REQUEST_GAP_MS=350
# Optional A-share trading calendar overrides. Comma-separated YYYY-MM-DD holidays.
# Configure the exchange calendar before unattended scheduling; weekends are always closed.
# A_SHARE_HOLIDAYS=2026-10-01,2026-10-02
# Preferred production mode: a versioned JSON file from an auditable exchange calendar.
# Schema: {"schemaVersion":"cn-trading-calendar-v1","source":"...","version":"...","tradingDates":["YYYY-MM-DD",...]}
# TRADING_CALENDAR_FILE=./config/cn-trading-calendar-2026.json

# QuickTiny 悟道 MCP（只读能力发现；接入首板前必须以 tools/list 返回的
# schema 为准，不要在没有授权和实时 schema 时猜测工具名/参数）。
# QUICKTINY_MCP_URL=https://stock.quicktiny.cn/api/mcp
# QUICKTINY_API_KEY=
# QUICKTINY_MCP_TIMEOUT_MS=12000
# The authorized ladder path is opt-in. Tool names were confirmed from live
# tools/list; the adapter still validates every argument against that live schema.
# QUICKTINY_LADDER_PROVIDER=quicktiny
# QUICKTINY_LADDER_TOOL_NAME=limit_up_ladder
# QUICKTINY_LADDER_FILTER_TOOL_NAME=limit_up_filter
# QUICKTINY_LADDER_TOOL_ARGS_JSON={} # legacy opaque-call compatibility only
# Optional explicit HTTP(S) proxy for market APIs only; no credentials in logs.
# MARKET_DATA_HTTP_PROXY=http://127.0.0.1:10809
